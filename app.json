{
  "expo": {
    "name": "Ping",
    "slug": "ping",
    "scheme": "ping",
    "icon": "./assets/icon.png",
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#D7FC65",
          "defaultChannel": "tasks"
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "PingTasks",
              "label": "Ping · 5 tarefas",
              "description": "As cinco tarefas pendentes mais recentes",
              "minWidth": "280dp",
              "minHeight": "280dp",
              "targetCellWidth": 4,
              "targetCellHeight": 4,
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "android": {
      "package": "com.example.ping",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0A0A09"
      },
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.example.ping"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "642c8d8f-c000-4d9c-8e27-54a5862fad11"
      }
    }
  }
}
